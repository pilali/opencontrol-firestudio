<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OpenControl for PreSonus FireStudio __VERSION__</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <options customize="allow" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="drivers"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="drivers" title="Drivers FireWire PreSonus __DRIVER__"
            description="Kext PaeFireStudio, démon et driver MIDI, extraits sans modification de l'installeur officiel Universal Control 3.4.2. Nécessite un Mac Intel. Un redémarrage et une autorisation dans Sécurité et confidentialité peuvent être demandés.">
        <pkg-ref id="presonus.pkg.Universal.Control.fw_audio_driver"/>
        <pkg-ref id="presonus.pkg.Universal.Control.fw_midi_driver"/>
    </choice>
    <choice id="app" title="FireStudio Mixer __VERSION__"
            description="Console de mixage, routage, vu-mètres et presets pour la FireStudio 26x26 (remplace FireControl / Universal Control).">
        <pkg-ref id="io.github.opencontrol-firestudio.mixer"/>
    </choice>

    <pkg-ref id="presonus.pkg.Universal.Control.fw_audio_driver" onConclusion="RequireRestart">presonus-fw-audio.pkg</pkg-ref>
    <pkg-ref id="presonus.pkg.Universal.Control.fw_midi_driver">presonus-fw-midi.pkg</pkg-ref>
    <pkg-ref id="io.github.opencontrol-firestudio.mixer">opencontrol-app.pkg</pkg-ref>
</installer-gui-script>

<?xml version="1.0" encoding="utf-8"?>
<!-- Product definition of the full installer. Titles and descriptions are keys of
     resources/<lang>.lproj/Localizable.strings; English is the fallback language. -->
<installer-gui-script minSpecVersion="2">
    <title>TITLE</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <options customize="allow" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
    <allowed-os-versions>
        <!-- macOS 26 removed IOFireWireFamily: neither the drivers nor the app can work there. -->
        <os-version min="12.0" before="26.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="drivers"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="drivers" title="DRIVERS_TITLE" description="DRIVERS_DESC">
        <pkg-ref id="presonus.pkg.Universal.Control.fw_audio_driver"/>
        <pkg-ref id="presonus.pkg.Universal.Control.fw_midi_driver"/>
    </choice>
    <choice id="app" title="APP_TITLE" description="APP_DESC">
        <pkg-ref id="io.github.opencontrol-firestudio.mixer"/>
    </choice>

    <pkg-ref id="presonus.pkg.Universal.Control.fw_audio_driver" version="__DRIVER__" onConclusion="RequireRestart">presonus-fw-audio.pkg</pkg-ref>
    <pkg-ref id="presonus.pkg.Universal.Control.fw_midi_driver" version="__DRIVER__">presonus-fw-midi.pkg</pkg-ref>
    <pkg-ref id="io.github.opencontrol-firestudio.mixer" version="__VERSION__">opencontrol-app.pkg</pkg-ref>
</installer-gui-script>
